{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Без фото — ошибка",
      "method": "POST",
      "path": "/",
      "body": {"image": ""},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "GET не поддерживается",
      "method": "GET",
      "path": "/",
      "expectedStatus": 405
    },
    {
      "name": "Слишком короткий запрос поиска",
      "method": "POST",
      "path": "/?action=search",
      "body": {"query": "ма"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Поиск по смыслу возвращает товары",
      "method": "POST",
      "path": "/?action=search",
      "body": {"query": "хочу чтобы в машине было тише"},
      "expectedStatus": 200,
      "expectedBody": {"explain": "string"},
      "bodyMatcher": "partial"
    }
  ]
}